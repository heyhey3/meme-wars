# Copy to .env and fill locally. Never commit .env.

# NEAR CLI / deploy
NEAR_NETWORK=testnet
NEAR_ACCOUNT_ID=war-demo.testnet
# near-cli-rs reads keys from the OS keychain; do not put a private key here.
# If you must use a legacy key file, set:
# NEAR_PRIVATE_KEY_FILE=/absolute/path/outside/the/repo.json

# Contract IDs
NEXT_PUBLIC_CONTRACT_ID=war-demo.testnet
NEXT_PUBLIC_NETWORK_ID=testnet
NEXT_PUBLIC_RPC_URL=https://rpc.testnet.fastnear.com

# Optional: simulation seed (defaults are fixed in source)
SIM_SEED=42

# Optional partner credentials. The core game never uses these.
# NEAR_INTENTS_API_KEY=
# NEAR_AI_API_KEY=
# BRRRAIN_API_KEY=
